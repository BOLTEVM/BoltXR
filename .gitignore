# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep local XR emulation flags and secrets out of builds/releases)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# electron-builder
/dist/

# runtime assets copied from node_modules by scripts/copy-vendor-assets.mjs
/public/vendor/

# game browser e2e output
/e2e/.out/

# Iced-Out XR mint art and holder data: never served from GitHub (this repo is public).
#   The public token art (stills, thumbnails, token metadata) goes to Arweave with
#   scripts/mint/upload-arweave.mjs; the 3D watches (GLB) are for holders and are never
#   uploaded anywhere public. lib/watch/editions.ts (generated from 150Watches/manifest.json)
#   stays committed, so the build does not need this folder.
/150Watches/
/public/watches/

# Arweave / Turbo signing keys (pay for uploads; keep them out of the repo)
*.jwk
*.jwk.json
arweave-wallet*.json
arweave-keyfile*.json
/.arweave/

# local GPU driver caches written next to the project
/NVIDIA Corporation/

# The Iced-Out XR watch module: a separate PRIVATE repository, checked out here (see README).
# Never commit it to this public repository. The paths after it are where the watch code lived
# before it moved there; they stay ignored so a stale copy cannot be committed by accident.
/private/
/_to_delete/
/lib/watch/
/lib/destruct/
/lib/mint/watchStage.ts
/components/xr/IcedWristWatch.tsx
/scripts/build-watch-editions.mjs
/scripts/sync-destruct.mjs
/scripts/mint/arweave.mjs
/scripts/mint/upload-arweave.mjs
/scripts/mint/prepare-metadata.mjs
/tests/mint/arweave.test.ts

# local UI test-run output (screenshots and server logs of a wallet session)
/artifacts/
/hartiixboltdelta/


